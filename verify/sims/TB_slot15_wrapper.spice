** Calculating tempco
*MEAS DC vrefMAX_m40to125 MAX V(vbias) FROM=-40 TO=125
*MEAS DC vrefMIN_m40to125 MIN V(vbias) FROM=-40 TO=125
MEAS DC vrefMAX_m30to85 MAX V(vbias) FROM=-30 TO=85
MEAS DC vrefMIN_m30to85 MIN V(vbias) FROM=-30 TO=85
MEAS DC vrefMAX_m20to85 MAX V(vbias) FROM=-20 TO=85
MEAS DC vrefMIN_m20to85 MIN V(vbias) FROM=-20 TO=85
MEAS DC Iout25 FIND I(VIOUT1) At=25

*LET tempco_m40_125_ppmC=1e6*(vrefMAX_m40to125 - vrefMIN_m40to125)/165/1.25
LET tempco_m30_85_ppmC=1e6*(vrefMAX_m30to85 - vrefMIN_m30to85)/115/1.25
