**.subckt TB_tinybgr
Vsup ADD5V 0 PAR_VDD5
C3 VREF 0 10f
Viout1 IOUT1 0 1
xbgrtop ADD5V VREF IOUT1 0 sg13cmos5l_srout_tinybgr
**** begin user architecture code

.option savecurrents
.PARAM PAR_VDD5=3.3
.PARAM PAR_VDDRISE=100e-6
.PARAM PAR_POFF=0
.PARAM PAR_NOFF=0
.OPTION TEMP=27

.control
run
save all

op
**write tb_bgr_op.raw
